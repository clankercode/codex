{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "InjectedMessage": {
      "properties": {
        "role": {
          "$ref": "#/definitions/InjectedMessageRole"
        },
        "text": {
          "description": "Plain-text message content. Use `thread/inject_items` when you need raw Responses API item control or non-text content.",
          "type": "string"
        }
      },
      "required": [
        "role",
        "text"
      ],
      "type": "object"
    },
    "InjectedMessageRole": {
      "enum": [
        "user",
        "assistant",
        "developer"
      ],
      "type": "string"
    }
  },
  "properties": {
    "messages": {
      "description": "Typed text messages to append to the thread's model-visible history.\n\nAssistant messages are stored as `output_text`; user and developer messages use `input_text`.",
      "items": {
        "$ref": "#/definitions/InjectedMessage"
      },
      "type": "array"
    },
    "threadId": {
      "type": "string"
    }
  },
  "required": [
    "messages",
    "threadId"
  ],
  "title": "ThreadInjectMessagesParams",
  "type": "object"
}